# Tessera provider config — copy to .env and fill in. NEVER commit .env.

# CAP / CROO endpoints
CROO_API_URL="https://api.croo.network"
CROO_WS_URL="wss://api.croo.network/ws"

# Provider SDK key from the CROO dashboard (agent.croo.network). Format: croo_sk_...
CROO_SDK_KEY=""

# SECOND agent's key, used only by cmd/requester to hire the service in a live
# demo. Required because CAP forbids an agent buying its own service. Its AA
# wallet must hold a little USDC (it pays the order). Falls back to CROO_SDK_KEY.
REQUESTER_SDK_KEY=""

# The registered service's ID (UUID), from its dashboard detail page.
SERVICE_ID=""

# Transport for the provider service:
#   loopback = in-memory harness, no credentials needed (Phase 0 demo)
#   croo     = live CAP via the real SDK (requires a registered agent + CROO_SDK_KEY)
TRANSPORT="loopback"

# Consensus mode: internal = own RPC/explorer sources; croo = also hire sub-agents.
CONSENSUS_MODE="internal"

# Consensus RPC pool. Leave unset to use the built-in vetted 10-operator default pool.
# Override with a comma-separated list (or BASE_RPC_URL_1..12). Add keyed providers
# (Alchemy/Infura/QuickNode/Ankr) here for a more robust 11+.
# BASE_RPC_URLS="https://mainnet.base.org,https://base.drpc.org,..."

# Consensus tuning.
CONSENSUS_QUORUM_FRACTION="0.8181818181818182"   # 9/11 supermajority of responders
CONSENSUS_MIN_RESPONDERS="7"                       # refuse to sign below this many live sources
CONSENSUS_MIN_CONFIRMATIONS="0"                    # 0 = require the finalized tag; N = require N confirmations

# Method-diverse explorer sources (abstain-safe).
BLOCKSCOUT_URL="https://base.blockscout.com"       # empty-string disables (unset uses this default)
BASESCAN_API_KEY=""                                # optional; enables the Basescan (Etherscan v2) source
CROO_CHECKER_SERVICE_ID=""                         # optional; hires a checker sub-agent in croo mode

# Oracle signing key for EIP-191 attestations (Phase 1). Also signs bond txs on Base.
# NOTE: for on-chain bonding this EOA needs a little ETH on Base (gas is NOT
# CROO-sponsored outside the CAP order flow) + USDC for the stake.
ORACLE_PRIVATE_KEY=""

# Honesty bond (Phase 3 — TesseraBond).
BOND_ENABLED="false"          # stamp the standing-bond field on verified proofs
BOND_CONTRACT=""              # deployed TesseraBond address on Base
BOND_STANDING_STAKE="0.50"    # display string for the oracle's standing stake
BOND_SLASH_USDC="10000"       # per-anchor earmark, USDC base units (6-dec); 10000 = 0.01 USDC
CHALLENGE_WINDOW_SEC="3600"   # window a challenger has to slash an anchored proof
BOND_ANCHOR="false"           # anchor verified proofs on-chain (needs BOND_CONTRACT + oracle ETH)
BOND_ANCHOR_SYNC="false"      # anchor before delivery (hero demo) vs async fire-and-forget
